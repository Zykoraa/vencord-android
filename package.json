{
  "name": "vencord-android",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Vencord-inspired client modification framework for Discord on Android (React Native / Hermes)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm --filter @vencord-mobile/core build && pnpm --filter @vencord-mobile/patcher build",
    "bundle": "pnpm --filter @vencord-mobile/core bundle",
    "dev": "pnpm --filter @vencord-mobile/patcher start",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "esbuild": "^0.23.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
